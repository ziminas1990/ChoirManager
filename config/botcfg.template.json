{
    "runtime_cache_filename": "./config/runtime.json",
    "google_cloud_key_file": "./config/google_cloud_key.json",
    "openai_api_key_file": "./config/openai_api_key",
    "logs_file": "/mnt/logs/bot.log",
    "runtime_dump_interval_sec": 10,
    "tg_adapter": {
        "token_file": "./config/tgbot_token",
        "bot_id": "",
        "formatting": "html"
    },
    "users_fetcher": {
        "google_sheet_id": "",
        "range": "Users!A:Z",
        "fetch_interval_sec": 60
    },
    "messages_provider": {
        "sheet_id": "",
        "table_name": "Messages"
    },
    "scores_fetcher": {
        "google_sheet_id": "",
        "range": "Scores!A:Z",
        "fetch_interval_sec": 3600
    },
    "deposit_tracking": {
        "google_sheet_id": "",
        "fetch_interval_sec": 30,
        "collect_interval_sec": 60,
        "reminders": [
            { "day_of_month": 15, "hour_utc": 12 },
            { "day_of_month": 25, "hour_utc": 12 }
        ],
        "startup_reminders_freeze_sec": 3600,
        "reminder_cooldown_hours": 24,
        "membership_fee": 70,
        "accounts": [
            {
                "title": "",
                "account": "",
                "receiver": ""
            }
        ]
    },
    "rehersals_tracker": {
        "fetch_interval_sec": 3600
    },
    "assistant": {
        "model": "gpt-5.4",
        "prompt_file": "./config/prompts/chorister_agent.md"
    },
    "feedback_storage": {
        "type": "google_spreadsheet",
        "spreadsheet_id": "",
        "sheet_name": "Feedbacks"
    },
    "transaction_storage": {
        "type": "google_firestore",
        "read_only": false,
        "database_id": "",
        "collection_name": "deposit_transactions"
    },
    "rehersals_storage": {
        "type": "google_spreadsheet",
        "spreadsheet_id": "",
        "sheet_name": "main"
    },
    "managers_chat": {
        "backlog": {
            "type": "google_firestore",
            "read_only": true,
            "database_id": "",
            "collection_name": "managers_chat_backlog"
        }
    },
    "managers_chat_agent": {
        "model": "gpt-5.4",
        "context_days": 3,
        "prompt_file": "./config/managers_chat_agent_prompt.txt"
    },
    "announce_chat": {
        "backlog": {
            "type": "google_firestore",
            "read_only": false,
            "database_id": "",
            "collection_name": "announce_chat_backlog"
        }
    },
    "new_records_tracker": {
        "fetch_interval_sec": 30,
        "tables": [
            {
                "google_sheet_id": "",
                "sheet": "Ответы на форму",
                "name": "Анкеты новых участников",
                "key_column": 1
            }
        ]
    },
    "task_tracker": {
        "database": {
            "type": "google_firestore",
            "database_id": "",
            "collection_name": "tasks"
        },
        "enable_notifications": true,
        "notification_time_utc": "08:00"
    },
    "attendance_tracker": {
        "skipped_rehersals_in_row": 3,
        "schedule_utc": [
            { "day_of_week_utc": 3, "time_utc": "12:00" },
            { "day_of_week_utc": 0, "time_utc": "15:00" }
        ]
    }
}
